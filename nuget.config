<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Clear inherited sources before adding our own. Without this, restore also
    uses whatever feeds the machine or build agent happens to have configured,
    which makes builds depend on the machine and lets an unrelated feed answer
    for a package name we expect from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
