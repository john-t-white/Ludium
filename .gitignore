# Claude Code: track only the shared configuration, never local settings
# (which may contain secrets) or machine-local runtime state
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/settings.json

# Build artifacts
bin/
obj/

# Test and coverage output
TestResults/
coverage/

# Next.js build artifacts
.next/
node_modules/

# dotenv
.env

# Next.js local env files (may contain secrets)
src/web/.env*.local

# .NET local appsettings overrides (may contain secrets)
src/api/appsettings.local.json
src/api/appsettings.*.local.json

# Temp files
~$*
*~

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix
